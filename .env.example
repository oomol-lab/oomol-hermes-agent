# Published image used by compose.yaml.
HERMES_IMAGE=ghcr.io/oomol/oomol-hermes-agent:latest

# The gateway binds to localhost by default. Set 0.0.0.0 only when remote
# access is intentional and the surrounding network is appropriately secured.
HERMES_BIND_ADDRESS=127.0.0.1
HERMES_PORT=8766

TZ=UTC

# Optional. When set, OO CLI uses it without interactive login. When empty,
# the first OO provider call returns a browser login URL and persists the
# completed login under /data. Never commit a populated .env file.
OO_API_KEY=
