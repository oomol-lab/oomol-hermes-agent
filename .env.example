# Published image used by compose.yaml.
HERMES_IMAGE=ghcr.io/oomol/oomol-hermes-agent:latest

# Required. OO CLI and the OOMOL LLM provider use this credential in memory.
# Get an API key at https://console.oomol.com/api-key.
# Never commit a populated .env file.
OO_API_KEY=

# Normal OOMOL LLM endpoint. This usually should not be changed.
OO_LLM_BASE_URL=https://llm.oomol.com/v1

# Recommended model and OpenAI-compatible wire protocol.
OO_LLM_MODEL=deepseek-v4-flash
OO_LLM_API_MODE=codex_responses
